@startuml
skinparam componentStyle uml2
skinparam backgroundColor white
skinparam component {
  BackgroundColor lightblue
  BorderColor darkblue
}

package "Portals (Topcoat SSR)" {
    [web_ui_guest] as WG <<Guest Portal>>
    [web_ui_admin] as WA <<Admin & Host Portal>>
    [web_ui_common] as WUC <<Shared UI>>
    [web_client] as WC <<API Client & Sessions>>
}

package "app_api" {
    [api_core] as AC <<API Infrastructure>>
    [booking_api] as BA <<Service>>
    [listing_api] as LA <<Service>>
    [user_api] as UA <<Service>>
    [image_worker] as IW <<Worker>>
    [email_worker] as EW <<Worker>>
}

[common] as COM <<Shared Domain>>
[db_core] as DC <<Database Access>>

' Portals: UI layer over the HTTP client; never the database
WG ..> WUC
WA ..> WUC
WG ..> WC
WA ..> WC
WUC ..> WC
WG ..> COM
WA ..> COM
WUC ..> COM
WC ..> COM
WC ..> BA : HTTP
WC ..> LA : HTTP
WC ..> UA : HTTP

' API dependencies (APIs never depend on each other)
BA ..> AC
LA ..> AC
UA ..> AC
IW ..> AC
EW ..> AC
BA ..> COM
LA ..> COM
UA ..> COM
IW ..> COM
EW ..> COM
BA ..> DC
LA ..> DC
UA ..> DC
IW ..> DC
EW ..> DC
AC ..> DC
AC ..> COM
DC ..> COM

@enduml
