  "query": "\n        SELECT id, blocked_date_id, source_feed_id, source_external_uid, checkout_date, status\n        FROM turnover\n        WHERE listing_id = $1\n          AND source_kind = 'ical_feed'\n          AND ($2::uuid IS NULL OR source_feed_id = $2 OR source_feed_id IS NULL)\n        ORDER BY id\n        FOR UPDATE\n        ",
