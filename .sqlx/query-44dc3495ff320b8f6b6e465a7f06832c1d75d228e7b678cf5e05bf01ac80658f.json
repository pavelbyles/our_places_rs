{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, guest_id, status as \"status: BookingStatus\" FROM booking \n        WHERE listing_id = $1 \n          AND (status = 'confirmed' OR (status = 'pending' AND expires_at > NOW()))\n          AND date_from - $4::int4 < $3\n          AND date_to + $4::int4 > $2\n        ",
