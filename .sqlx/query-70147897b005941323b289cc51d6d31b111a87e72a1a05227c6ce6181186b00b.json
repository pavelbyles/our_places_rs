  "query": "\n        SELECT\n            id,\n            document_type as \"document_type: TaxDocumentType\",\n            document_number,\n            revision,\n            status as \"status: TaxDocumentStatus\",\n            supersedes_id,\n            booking_id,\n            booking_history_id,\n            recipient_id,\n            listing_id,\n            issue_date,\n            supplier_name,\n            supplier_address,\n            supplier_trn,\n            recipient_name,\n            recipient_email,\n            recipient_company_name,\n            recipient_trn,\n            currency,\n            exchange_rate,\n            jmd_exchange_rate,\n            accommodation_net,\n            cleaning_fee,\n            taxable_amount,\n            tax_rate,\n            tax_amount,\n            platform_fee,\n            damage_deposit,\n            total_amount,\n            amount_previously_paid,\n            balance_due,\n            refund_pct,\n            retained_amount,\n            jmd_tax_amount,\n            jmd_total_amount,\n            line_items,\n            created_at\n        FROM tax_document\n        WHERE booking_id = $1 AND document_type = $2 AND status = 'issued'::tax_document_status\n        ",
