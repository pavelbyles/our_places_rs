{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, c.listing_id, c.guest_id, c.created_at, c.last_message_at,\n            l.user_id AS host_id\n        FROM conversation c\n        JOIN listing l ON l.id = c.listing_id\n        WHERE c.id = $1\n        ",
