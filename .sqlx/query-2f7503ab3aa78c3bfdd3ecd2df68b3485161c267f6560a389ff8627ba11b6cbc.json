{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                u.id,\n                u.email,\n                u.first_name,\n                u.last_name,\n                u.password_hash,\n                u.is_active,\n                u.is_verified,\n                hs.created_at AS invited_at\n            FROM host_staff hs\n            INNER JOIN \"user\" u ON u.id = hs.staff_user_id\n            WHERE hs.host_user_id = $1\n              AND u.id = $2\n              AND u.deleted_at IS NULL\n            ",
