  "query": "\n        UPDATE review_token\n        SET used_at = NOW()\n        WHERE token = $1 \n          AND used_at IS NULL \n          AND valid_from <= NOW() \n          AND expires_at > NOW()\n        RETURNING id, token, booking_id, guest_id, listing_id, valid_from, expires_at, used_at, created_at\n        ",
