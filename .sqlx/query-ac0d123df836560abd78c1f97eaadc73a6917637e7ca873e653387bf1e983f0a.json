  "query": "\n        SELECT\n            id,\n            email,\n            password_hash,\n            first_name,\n            is_active,\n            deleted_at,\n            roles AS \"roles: Vec<UserRole>\"\n        FROM \"user\"\n        WHERE LOWER(BTRIM(email)) = $1\n        ORDER BY created_at ASC\n        LIMIT 1\n        FOR UPDATE\n        ",
