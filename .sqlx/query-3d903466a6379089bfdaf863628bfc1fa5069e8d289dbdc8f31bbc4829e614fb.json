{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            h.id,\n            h.turnover_id,\n            h.from_status,\n            h.to_status,\n            h.actor_user_id,\n            NULLIF(\n                BTRIM(COALESCE(u.first_name, '') || ' ' || COALESCE(u.last_name, '')),\n                ''\n            ) AS actor_name,\n            h.actor_role,\n            h.entry_point,\n            h.reason,\n            h.created_at\n        FROM turnover_status_history h\n        LEFT JOIN \"user\" u ON u.id = h.actor_user_id\n        WHERE h.turnover_id = $1\n        ORDER BY h.created_at ASC, h.id ASC\n        ",
